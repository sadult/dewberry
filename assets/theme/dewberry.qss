/* =====================================================================
   Dewberry — unified design system
   Palette: near-black navy base, neutral dark surfaces, restrained
   blue / cyan / violet accents reserved for interactive + status.
   Radii: 18 (shell), 16 (cards), 12 (controls), 10 (inputs), 999 (pills)
   ===================================================================== */

/* ---- base ---- */
QWidget {
    color: #E6EAF2;
    font-size: 13px;
    selection-background-color: rgba(59,130,246,0.35);
    selection-color: #FFFFFF;
}

#Window {
    background: #0A0F1C;
    border: 1px solid #18213A;
    border-radius: 18px;
}

#Page { background: transparent; }

/* ---- title bar ---- */
#TitleBar { background: transparent; }
#TitleTitle { color: #9AA6BD; font-size: 12.5px; font-weight: 600; letter-spacing: 0.4px; }

/* ---- sidebar ---- */
#Sidebar {
    background: #0C1220;
    border: 1px solid #18213A;
    border-radius: 16px;
}
#BrandName { color: #F5F7FB; font-size: 17px; font-weight: 800; letter-spacing: 0.3px; }
#BrandTagline { color: #6C7690; font-size: 11px; }

#Nav {
    background: transparent;
    border: none;
    outline: 0;
}
#Nav::item {
    color: #9AA6BD;
    padding: 10px 12px;
    margin: 2px 6px;
    border-radius: 12px;
    border: 1px solid transparent;
}
#Nav::item:hover {
    background: #121A2C;
    color: #E6EAF2;
}
#Nav::item:selected {
    background: rgba(59,130,246,0.14);
    color: #FFFFFF;
    border: 1px solid rgba(59,130,246,0.35);
}

/* ---- typography ---- */
#H1 { color: #F5F7FB; font-size: 22px; font-weight: 800; letter-spacing: 0.2px; }
#H2 { color: #F5F7FB; font-size: 15px; font-weight: 700; }
#Caption { color: #7E8AA0; font-size: 12px; }
#Muted { color: #7E8AA0; font-size: 13px; }
#Faint { color: #5A6377; font-size: 11px; letter-spacing: 0.6px; }
#SectionLabel { color: #6C7690; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; }

/* ---- cards ---- */
#Card {
    background: #0F1524;
    border: 1px solid #18213A;
    border-radius: 16px;
}
#Card:hover { border: 1px solid #223056; }
#CardTitle { color: #F5F7FB; font-size: 14px; font-weight: 700; }
#CardHint  { color: #6C7690; font-size: 11px; }

#Inset {
    background: #0B111F;
    border: 1px solid #16203A;
    border-radius: 12px;
}

/* ---- key/value fields ---- */
#FieldKey   { color: #7E8AA0; font-size: 12px; }
#FieldValue { color: #E6EAF2; font-size: 13px; font-weight: 600; }
#Metric     { color: #F5F7FB; font-size: 26px; font-weight: 800; }
#MetricUnit { color: #6C7690; font-size: 12px; font-weight: 600; }

/* ---- badges (compact status pills) ---- */
#Badge {
    border-radius: 999px;
    border: 1px solid #223056;
    background: #0C1220;
}
#Badge[level="good"] { border-color: rgba(52,211,153,0.4);  background: rgba(52,211,153,0.10); }
#Badge[level="mid"]  { border-color: rgba(251,191,36,0.4);  background: rgba(251,191,36,0.10); }
#Badge[level="bad"]  { border-color: rgba(248,113,113,0.4); background: rgba(248,113,113,0.10); }
#Badge[level="busy"] { border-color: rgba(59,130,246,0.45); background: rgba(59,130,246,0.12); }
#Badge[level="off"]  { border-color: #223056; background: #0C1220; }
#BadgeText { font-size: 11.5px; font-weight: 700; background: transparent; }
#BadgeText[level="good"] { color: #34D399; }
#BadgeText[level="mid"]  { color: #FBBF24; }
#BadgeText[level="bad"]  { color: #F87171; }
#BadgeText[level="busy"] { color: #60A5FA; }
#BadgeText[level="off"]  { color: #7E8AA0; }

#Chip {
    background: #0B111F;
    border: 1px solid #16203A;
    border-radius: 14px;
}

/* ---- buttons ---- */
QPushButton {
    background: #131A2C;
    color: #E6EAF2;
    border: 1px solid #223056;
    border-radius: 11px;
    padding: 9px 16px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton:hover { background: #182236; border-color: #2C3C68; }
QPushButton:pressed { background: #0F1524; }
QPushButton:disabled { color: #4C566E; background: #0E1524; border-color: #172038; }

QPushButton#Primary {
    background: #3B82F6;
    color: #FFFFFF;
    border: 1px solid #3B82F6;
}
QPushButton#Primary:hover { background: #4C8FF8; border-color: #4C8FF8; }
QPushButton#Primary:pressed { background: #2E6FDB; }
QPushButton#Primary:disabled { background: #1B2A49; color: #6E86B8; border-color: #1B2A49; }

QPushButton#Danger { border-color: rgba(248,113,113,0.4); color: #F87171; }
QPushButton#Danger:hover { background: rgba(248,113,113,0.12); }

QPushButton#Ghost { background: transparent; border: 1px solid #223056; }
QPushButton#Ghost:hover { background: #131A2C; }

QPushButton#IconGhost {
    background: transparent; border: 1px solid transparent;
    padding: 6px; border-radius: 10px;
}
QPushButton#IconGhost:hover { background: #182236; border: 1px solid #223056; }

/* ---- inputs ---- */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit#Field, QTextEdit {
    background: #0B111F;
    color: #E6EAF2;
    border: 1px solid #1C2743;
    border-radius: 10px;
    padding: 8px 11px;
    selection-background-color: rgba(59,130,246,0.35);
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #3B82F6;
    background: #0C1424;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color: #566082; }
QLineEdit[invalid="true"] { border: 1px solid #F87171; }

QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
    background: #0F1524;
    border: 1px solid #223056;
    border-radius: 10px;
    padding: 4px;
    selection-background-color: rgba(59,130,246,0.20);
    outline: 0;
}
QSpinBox::up-button, QSpinBox::down-button { width: 0; border: none; }

/* ---- checkboxes ---- */
QCheckBox { spacing: 9px; color: #C6CEDE; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border-radius: 6px;
    border: 1px solid #2C3C68;
    background: #0B111F;
}
QCheckBox::indicator:hover { border-color: #3B82F6; }
QCheckBox::indicator:checked {
    background: #3B82F6; border: 1px solid #3B82F6;
    image: url(ASSETS/icons/ui/check.svg);
}

/* ---- terminal / log console ---- */
#Terminal {
    background: #070B14;
    color: #C8D2E4;
    border: 1px solid #16203A;
    border-radius: 12px;
    padding: 10px 12px;
    font-family: "Menlo", "Consolas", "Liberation Mono", monospace;
    font-size: 12px;
}

/* ---- tables / lists ---- */
QTableWidget, QListWidget {
    background: transparent;
    border: none;
    outline: 0;
    gridline-color: transparent;
}
QTableWidget::item, QListWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #131C33;
}
QTableWidget::item:selected, QListWidget::item:selected {
    background: rgba(59,130,246,0.14);
    color: #FFFFFF;
}
QHeaderView::section {
    background: transparent;
    color: #6C7690;
    border: none;
    border-bottom: 1px solid #1C2743;
    padding: 8px;
    font-size: 11px;
    font-weight: 700;
}
QTableCornerButton::section { background: transparent; border: none; }

/* ---- scrollbars ---- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 4px; }
QScrollBar::handle:vertical { background: #223056; border-radius: 5px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: #2C3C68; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 4px; }
QScrollBar::handle:horizontal { background: #223056; border-radius: 5px; min-width: 36px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- tooltip ---- */
QToolTip {
    background: #0F1524;
    color: #E6EAF2;
    border: 1px solid #223056;
    border-radius: 8px;
    padding: 6px 9px;
}

/* ---- toggle track (custom widget draws its own knob) ---- */
#ToggleTrack { border-radius: 999px; }

/* ---- scroll areas (page shells) ------------------------------------
   Page bodies are wrapped in a QScrollArea whose viewport otherwise
   paints an opaque default (grey) surface behind transparent pages.
   Make the scroll area and its viewport transparent so the dark window
   shows through. Targeted at QScrollArea only, so lists/tables keep
   their own backgrounds. */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
QScrollArea > QWidget#qt_scrollarea_viewport {
    background: transparent;
}
